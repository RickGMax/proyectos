/// Encuesta Epoch AI e Ipsos, 9–11 de octubre de 2026, Estados Unidos. Una fila por herramienta y ámbito. Selección múltiple.
table Uso
	lineageTag: 7d017936-4efa-5613-b2a4-f19e085c9fc0

	measure 'Personal · personas' = CALCULATE(SELECTEDVALUE(Uso[Encuestados]), KEEPFILTERS(Uso[Ámbito] = "Personal"))
